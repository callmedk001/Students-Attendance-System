rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function roleIs(role) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true;
    }

    function ownProfile(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function noPeriodTiming(data) {
      return !data.keys().hasAny(['startTime', 'endTime', 'periodStart', 'periodEnd']);
    }

    function validPeriod(data) {
      return data.periodNumber is int && data.periodNumber >= 1 && data.periodNumber <= 8;
    }

    match /users/{userId} {
      allow read: if ownUser(userId);
      allow create, update, delete: if false;
    }

    // Username mappings and all account profile writes are server-side only.
    match /usernames/{username} {
      allow read, write: if false;
    }

    match /students/{studentId} {
      allow read: if ownUser(studentId) && roleIs('STUDENT');
      allow create, update, delete: if false;
    }

    match /teachers/{teacherId} {
      allow read: if ownUser(teacherId) && roleIs('TEACHER');
      allow create, update, delete: if false;
    }

    match /classes/{classId} {
      allow read: if roleIs('STUDENT')
        && get(/databases/$(database)/documents/students/$(request.auth.uid)).data.classId == classId
        && resource.data.active == true;
      allow write: if false;
    }

    match /subjects/{subjectId} {
      allow read: if roleIs('STUDENT')
        && resource.data.active == true
        && get(/databases/$(database)/documents/students/$(request.auth.uid)).data.classId == resource.data.classId;
      allow write: if false;
    }

    match /periods/{periodId} {
      allow read: if (roleIs('TEACHER') || roleIs('STUDENT'))
        && periodId in ['1', '2', '3', '4', '5', '6', '7', '8']
        && resource.data.periodNumber == int(periodId)
        && resource.data.active == true
        && resource.data.keys().hasOnly(['periodNumber', 'label', 'active']);
      allow write: if false;
    }

    match /attendanceSessions/{sessionId} {
        allow read: if (roleIs('TEACHER')
          && resource.data.teacherId == request.auth.uid)
        || (roleIs('STUDENT')
          && get(/databases/$(database)/documents/students/$(request.auth.uid)).data.classId == resource.data.classId);
      allow create: if roleIs('TEACHER')
        && request.resource.data.teacherId == request.auth.uid
        && validPeriod(request.resource.data)
        && noPeriodTiming(request.resource.data)
        && request.resource.data.keys().hasOnly(['date', 'classId', 'subjectId', 'periodNumber', 'teacherId', 'status']);
      allow update: if roleIs('TEACHER')
        && resource.data.teacherId == request.auth.uid
        && request.resource.data.teacherId == request.auth.uid
        && validPeriod(request.resource.data)
        && noPeriodTiming(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['date', 'classId', 'subjectId', 'periodNumber', 'status']);
      allow delete: if false;
    }

    match /attendanceRecords/{recordId} {
      allow read: if (roleIs('TEACHER')
          && get(/databases/$(database)/documents/attendanceSessions/$(resource.data.sessionId)).data.teacherId == request.auth.uid)
        || (roleIs('STUDENT')
          && resource.data.studentId == request.auth.uid);
      allow create, update: if roleIs('TEACHER')
        && get(/databases/$(database)/documents/attendanceSessions/$(request.resource.data.sessionId)).data.teacherId == request.auth.uid
        && request.resource.data.status in ['PRESENT', 'ABSENT', 'OD']
        && request.resource.data.keys().hasOnly(['sessionId', 'studentId', 'status', 'markedAt', 'updatedAt']);
      allow delete: if false;
    }
  }
}